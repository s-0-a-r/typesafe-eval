{
  "description": "TypeSafe document evaluation safety hook for Claude Code",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 hooks/claude_safety_hook.py"
          }
        ]
      }
    ]
  }
}
